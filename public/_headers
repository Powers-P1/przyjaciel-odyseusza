/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com 'sha256-B+noZ/isOvNQAdpktj9LQF4ygbUujLOVbeVtWabzKbc='; style-src 'self' 'sha256-kpurah24m3WNL5ANMuf5dllXJOnRKVNkEIYFNf+PLgc='; img-src 'self' data:; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; form-action 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=2592000

/assets/icons/*
  Cache-Control: public, max-age=2592000

/assets/js/*
  # adres skryptu niesie odcisk treści (?v=…), więc cache może być roczny
  Cache-Control: public, max-age=31536000, immutable

# Uwaga: Cloudflare nie stosuje tego pliku do odpowiedzi z Pages Functions,
# dlatego /api/contact ustawia swoje nagłówki samodzielnie (functions/api/contact.js).

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

/llms.txt
  Content-Type: text/plain; charset=utf-8
